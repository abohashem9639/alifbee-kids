<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Widget.KidsDemo.NumberKey" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/white</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">24dp</item>
        <item name="android:insetTop">6dp</item>
        <item name="android:insetBottom">6dp</item>
        <item name="elevation">2dp</item>
        <item name="rippleColor">#22000000</item>
    </style>

    <style name="Widget.KidsDemo.NumberKey.Backspace">
        <item name="backgroundTint">@color/key_backspace</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="ShapeAppearance.KidsDemo.ProfileBg" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">24dp</item>
    </style>

    <style name="Widget.KidsDemo.BottomNav" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="itemActiveIndicatorStyle">@style/Widget.KidsDemo.BottomNav.ActiveIndicator</item>
    </style>

    <style name="Widget.KidsDemo.BottomNav.ActiveIndicator" parent="">
        <item name="android:width">0dp</item>
        <item name="android:height">0dp</item>
        <item name="android:color">@android:color/transparent</item>
        <item name="marginHorizontal">0dp</item>
    </style>
</resources>
