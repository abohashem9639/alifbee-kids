<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/parents_lock_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brand_blue">

    <ImageButton
        android:id="@+id/back_button"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_margin="@dimen/spacing_sm"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/cd_back"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/parents_lock"
        android:textColor="@color/white"
        android:textSize="@dimen/text_title"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/back_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/back_button" />

    <GridLayout
        android:id="@+id/keypad"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_lg"
        android:columnCount="3"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.alifbee.kidsdemo.ui.components.PushButton
            android:id="@+id/key_1"
            android:layout_width="88dp"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/spacing_xs"
            app:pbBaseColor="@color/key_base"
            app:pbCornerRadius="@dimen/radius_key"
            app:pbDepth="4dp"
            app:pbFaceColor="@color/white"
            app:pbText="1"
            app:pbTextColor="@color/brand_purple"
            app:pbTextSize="20sp" />

        <com.alifbee.kidsdemo.ui.components.PushButton
            android:id="@+id/key_2"
            android:layout_width="88dp"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/spacing_xs"
            app:pbBaseColor="@color/key_base"
            app:pbCornerRadius="@dimen/radius_key"
            app:pbDepth="4dp"
            app:pbFaceColor="@color/white"
            app:pbText="2"
            app:pbTextColor="@color/brand_purple"
            app:pbTextSize="20sp" />

        <com.alifbee.kidsdemo.ui.components.PushButton
            android:id="@+id/key_3"
            android:layout_width="88dp"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/spacing_xs"
            app:pbBaseColor="@color/key_base"
            app:pbCornerRadius="@dimen/radius_key"
            app:pbDepth="4dp"
            app:pbFaceColor="@color/white"
            app:pbText="3"
            app:pbTextColor="@color/brand_purple"
            app:pbTextSize="20sp" />

        <com.alifbee.kidsdemo.ui.components.PushButton
            android:id="@+id/key_4"
            android:layout_width="88dp"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/spacing_xs"
            app:pbBaseColor="@color/key_base"
            app:pbCornerRadius="@dimen/radius_key"
            app:pbDepth="4dp"
            app:pbFaceColor="@color/white"
            app:pbText="4"
            app:pbTextColor="@color/brand_purple"
            app:pbTextSize="20sp" />

        <com.alifbee.kidsdemo.ui.components.PushButton
            android:id="@+id/key_5"
            android:layout_width="88dp"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/spacing_xs"
            app:pbBaseColor="@color/key_base"
            app:pbCornerRadius="@dimen/radius_key"
            app:pbDepth="4dp"
            app:pbFaceColor="@color/white"
            app:pbText="5"
            app:pbTextColor="@color/brand_purple"
            app:pbTextSize="20sp" />

        <com.alifbee.kidsdemo.ui.components.PushButton
            android:id="@+id/key_6"
            android:layout_width="88dp"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/spacing_xs"
            app:pbBaseColor="@color/key_base"
            app:pbCornerRadius="@dimen/radius_key"
            app:pbDepth="4dp"
            app:pbFaceColor="@color/white"
            app:pbText="6"
            app:pbTextColor="@color/brand_purple"
            app:pbTextSize="20sp" />

        <com.alifbee.kidsdemo.ui.components.PushButton
            android:id="@+id/key_7"
            android:layout_width="88dp"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/spacing_xs"
            app:pbBaseColor="@color/key_base"
            app:pbCornerRadius="@dimen/radius_key"
            app:pbDepth="4dp"
            app:pbFaceColor="@color/white"
            app:pbText="7"
            app:pbTextColor="@color/brand_purple"
            app:pbTextSize="20sp" />

        <com.alifbee.kidsdemo.ui.components.PushButton
            android:id="@+id/key_8"
            android:layout_width="88dp"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/spacing_xs"
            app:pbBaseColor="@color/key_base"
            app:pbCornerRadius="@dimen/radius_key"
            app:pbDepth="4dp"
            app:pbFaceColor="@color/white"
            app:pbText="8"
            app:pbTextColor="@color/brand_purple"
            app:pbTextSize="20sp" />

        <com.alifbee.kidsdemo.ui.components.PushButton
            android:id="@+id/key_9"
            android:layout_width="88dp"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/spacing_xs"
            app:pbBaseColor="@color/key_base"
            app:pbCornerRadius="@dimen/radius_key"
            app:pbDepth="4dp"
            app:pbFaceColor="@color/white"
            app:pbText="9"
            app:pbTextColor="@color/brand_purple"
            app:pbTextSize="20sp" />

        <Space
            android:layout_width="72dp"
            android:layout_height="1dp"
            android:layout_margin="@dimen/spacing_xs" />

        <com.alifbee.kidsdemo.ui.components.PushButton
            android:id="@+id/key_0"
            android:layout_width="88dp"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/spacing_xs"
            app:pbBaseColor="@color/key_base"
            app:pbCornerRadius="@dimen/radius_key"
            app:pbDepth="4dp"
            app:pbFaceColor="@color/white"
            app:pbText="0"
            app:pbTextColor="@color/brand_purple"
            app:pbTextSize="20sp" />

        <com.alifbee.kidsdemo.ui.components.PushButton
            android:id="@+id/key_backspace"
            android:layout_width="88dp"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/spacing_xs"
            app:pbBaseColor="@color/key_backspace_shadow"
            app:pbCornerRadius="@dimen/radius_key"
            app:pbDepth="4dp"
            app:pbFaceColor="@color/key_backspace"
            app:pbText="&lt;&lt;"
            app:pbTextColor="@color/white"
            app:pbTextSize="20sp" />

    </GridLayout>

    <LinearLayout
        android:id="@+id/pin_row"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_lg"
        android:orientation="horizontal"
        app:layout_constraintBottom_toTopOf="@id/keypad"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/spacing_md"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/pin_0"
                android:layout_width="44dp"
                android:layout_height="40dp"
                android:gravity="center"
                android:textColor="@color/white"
                android:textSize="26sp"
                android:textStyle="bold" />

            <View
                android:layout_width="44dp"
                android:layout_height="3dp"
                android:background="@color/white" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/spacing_md"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/pin_1"
                android:layout_width="44dp"
                android:layout_height="40dp"
                android:gravity="center"
                android:textColor="@color/white"
                android:textSize="26sp"
                android:textStyle="bold" />

            <View
                android:layout_width="44dp"
                android:layout_height="3dp"
                android:background="@color/white" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/spacing_md"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/pin_2"
                android:layout_width="44dp"
                android:layout_height="40dp"
                android:gravity="center"
                android:textColor="@color/white"
                android:textSize="26sp"
                android:textStyle="bold" />

            <View
                android:layout_width="44dp"
                android:layout_height="3dp"
                android:background="@color/white" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/code_words"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_md"
        android:textColor="@color/white"
        android:textSize="@dimen/text_heading"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@id/pin_row"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:text="Four, Nine, Six" />

    <TextView
        android:id="@+id/enter_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_xs"
        android:text="@string/enter_the_numbers"
        android:textColor="@color/white"
        android:textSize="@dimen/text_body"
        app:layout_constraintBottom_toTopOf="@id/code_words"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <ImageView
        android:id="@+id/illustration"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/spacing_sm"
        android:layout_marginBottom="@dimen/spacing_sm"
        android:adjustViewBounds="true"
        android:contentDescription="@string/cd_illustration"
        android:scaleType="fitCenter"
        android:src="@drawable/img_parents_lock"
        app:layout_constraintBottom_toTopOf="@id/enter_text"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/title"
        app:layout_constraintWidth_max="250dp" />

</androidx.constraintlayout.widget.ConstraintLayout>
