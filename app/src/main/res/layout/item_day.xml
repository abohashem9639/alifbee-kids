<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/day_cell"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:id="@+id/day_highlight"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingVertical="@dimen/spacing_sm">

        <TextView
            android:id="@+id/day_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_body"
            tools:text="Mon" />

        <FrameLayout
            android:id="@+id/day_indicator"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginTop="@dimen/spacing_sm"
            android:background="@drawable/bg_day_completed">

            <ImageView
                android:id="@+id/day_lightning"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_black_lightning" />
        </FrameLayout>

    </LinearLayout>

</FrameLayout>
