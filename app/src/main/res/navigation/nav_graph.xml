<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/splashFragment">

    <fragment
        android:id="@+id/splashFragment"
        android:name="com.alifbee.kidsdemo.ui.splash.SplashFragment"
        android:label="SplashFragment"
        tools:layout="@layout/fragment_splash">
        <action
            android:id="@+id/action_splash_to_home"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.alifbee.kidsdemo.ui.home.HomeFragment"
        android:label="HomeFragment"
        tools:layout="@layout/fragment_home">
        <action
            android:id="@+id/action_home_to_parents_lock"
            app:destination="@id/parentsLockFragment" />
    </fragment>

    <fragment
        android:id="@+id/parentsLockFragment"
        android:name="com.alifbee.kidsdemo.ui.parents.ParentsLockFragment"
        android:label="ParentsLockFragment"
        tools:layout="@layout/fragment_parents_lock">
        <action
            android:id="@+id/action_parents_lock_to_more_apps"
            app:destination="@id/moreAppsFragment"
            app:popUpTo="@id/parentsLockFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/moreAppsFragment"
        android:name="com.alifbee.kidsdemo.ui.more.MoreAppsFragment"
        android:label="MoreAppsFragment"
        tools:layout="@layout/fragment_more_apps" />

</navigation>
